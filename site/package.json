{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:public": "node scripts/build-public.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "approve:candidate": "node scripts/approve-candidate.mjs",
    "publish:candidate": "node scripts/publish-candidate.mjs",
    "ingest:github": "node scripts/github-ingest-candidate.mjs",
    "classify:candidates": "node scripts/classify-candidates.mjs",
    "enrich:candidates": "node scripts/enrich-candidates.mjs",
    "dedupe:candidates": "node scripts/dedupe-candidates.mjs",
    "dedupe:candidates:dry": "node scripts/dedupe-candidates.mjs --dry-run",
    "sync:tool-types": "node scripts/sync-published-tool-types.mjs",
    "sync:tool-types:dry": "node scripts/sync-published-tool-types.mjs --dry-run",
    "discover:tools": "node scripts/tools-github-crawler.mjs",
    "discover:tools:dry": "node scripts/tools-github-crawler.mjs --dry-run",
    "discover:agents": "node scripts/agents-source-crawler.mjs",
    "discover:agents:dry": "node scripts/agents-source-crawler.mjs --dry-run",
    "discover:learn": "node scripts/learn-source-crawler.mjs",
    "discover:learn:dry": "node scripts/learn-source-crawler.mjs --dry-run",
    "discover:signals": "node scripts/signals-source-crawler.mjs",
    "discover:signals:dry": "node scripts/signals-source-crawler.mjs --dry-run",
    "auto:publish": "node scripts/auto-publish-candidates.mjs --discover",
    "auto:publish:dry": "node scripts/auto-publish-candidates.mjs --discover --dry-run",
    "test:ingest": "node --test scripts/*.test.mjs",
    "generate:signals": "node scripts/arxiv-signal-generator.mjs",
    "generate:signals:dry": "node scripts/arxiv-signal-generator.mjs --dry-run",
    "generate:learn": "node scripts/ecosystem-learn-generator.mjs",
    "generate:learn:dry": "node scripts/ecosystem-learn-generator.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "astro": "^6.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}

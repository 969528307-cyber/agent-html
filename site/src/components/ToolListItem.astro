---
interface ToolData {
  id: string;
  name: string;
  type: string;
  summary: string;
  category: string[];
  compatibleAgents: string[];
}

interface Props {
  tool: ToolData;
}

const { tool } = Astro.props;
const categoryLabel = [tool.type, ...tool.category.slice(0, 2)].join(" · ");
const agentLabel = tool.compatibleAgents.slice(0, 4).join(" · ");
---

<article class="tool-row">
  <div class="tool-main">
    <div class="meta-line">{categoryLabel}</div>
    <h3><a href={`/item/${tool.id}`}>{tool.name}</a></h3>
    <p>{tool.summary}</p>
    {agentLabel && <div class="agent-line">{agentLabel}</div>}
  </div>
  <a class="open-link" href={`/item/${tool.id}`}>Open</a>
</article>

<style>
  .tool-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 18px 20px;
    border: 1px solid rgb(246 242 234 / 0.1);
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgb(246 242 234 / 0.055), rgb(246 242 234 / 0.018)),
      rgb(12 17 24 / 0.78);
    box-shadow: 0 18px 60px rgb(0 0 0 / 0.18);
    backdrop-filter: blur(24px);
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .tool-row:hover {
    border-color: rgb(134 174 255 / 0.28);
    background:
      linear-gradient(180deg, rgb(134 174 255 / 0.08), rgb(246 242 234 / 0.02)),
      rgb(12 17 24 / 0.84);
    transform: translateY(-2px);
  }

  .meta-line,
  .agent-line {
    color: #8fb7ff;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin-top: 8px;
    color: #f6f2ea;
    font-family: var(--sans);
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  h3 a:hover {
    color: #8fb7ff;
  }

  p {
    max-width: 820px;
    margin-top: 8px;
    color: #9aa4b6;
    font-size: 14px;
    line-height: 1.55;
  }

  .agent-line {
    margin-top: 10px;
    color: #bbf2d9;
    font-size: 11px;
  }

  .open-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 76px;
    min-height: 38px;
    padding: 0 14px;
    color: #06100b;
    font-weight: 850;
    border-radius: 999px;
    background: #a9d8b0;
  }

  @media (max-width: 700px) {
    .tool-row {
      grid-template-columns: 1fr;
    }

    .open-link {
      width: fit-content;
    }
  }
</style>

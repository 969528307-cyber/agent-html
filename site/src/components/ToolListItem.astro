---
interface ToolData {
  id: string;
  name: string;
  type: string;
  summary: string;
  category: string[];
  compatibleAgents: string[];
  installCommand?: string;
}

interface Props {
  tool: ToolData;
}

const { tool } = Astro.props;
---

<article class="list-item">
  <div>
    <div class="card-top">
      <h3><a href={`/item/${tool.id}`}>{tool.name}</a></h3>
      <span class="badge">{tool.type.toUpperCase()}</span>
    </div>
    <p>{tool.summary}</p>
    <div class="meta">
      {tool.category.map((category) => <span>{category}</span>)}
      {tool.compatibleAgents.slice(0, 3).map((agent) => <span>{agent}</span>)}
    </div>
  </div>
  {tool.installCommand && <code class="command">{tool.installCommand}</code>}
</article>

<style>
  .list-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.42fr);
    gap: 18px;
    align-items: center;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background:
      linear-gradient(180deg, rgb(238 244 238 / 0.035), rgb(238 244 238 / 0.012)),
      var(--paper);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: flex-start;
  }

  h3 a:hover {
    color: var(--sage);
  }

  p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 10px;
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
    background: var(--sage-soft);
    border: 1px solid rgb(167 207 164 / 0.18);
    border-radius: 999px;
  }

  .meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .meta span {
    padding: 7px 9px;
    color: var(--muted);
    font-size: 12px;
    background: rgb(238 244 238 / 0.035);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .command {
    padding: 10px 12px;
    overflow: hidden;
    color: var(--sage);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    background: var(--sage-soft);
    border: 1px solid rgb(167 207 164 / 0.14);
    border-radius: 14px;
  }

  @media (max-width: 760px) {
    .list-item {
      grid-template-columns: 1fr;
    }
  }
</style>

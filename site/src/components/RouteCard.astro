---
interface Props {
  href: string;
  kicker: string;
  title: string;
  description: string;
}

const { href, kicker, title, description } = Astro.props;
---

<a class="route-card" href={href}>
  <small>{kicker}</small>
  <strong>{title}</strong>
  <p>{description}</p>
</a>

<style>
  .route-card {
    display: grid;
    gap: 14px;
    min-height: 160px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgb(238 244 238 / 0.04), rgb(238 244 238 / 0.012)),
      var(--paper);
    box-shadow: var(--shadow);
  }

  .route-card:hover {
    border-color: var(--line-strong);
  }

  strong {
    font-size: 23px;
    letter-spacing: -0.04em;
  }

  small {
    color: var(--sage);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  p {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.65;
  }
</style>

---
interface AgentData {
  name: string;
  region: "global" | "china";
  vendor?: string;
  summary: string;
  documentationUrl: string;
  sources: {
    label: string;
    url: string;
    kind: "official" | "docs" | "github" | "quickstart" | "release" | "community";
  }[];
  bestFor: string[];
  interfaceType: string[];
  supportsMcp: boolean;
  supportsSkills: boolean;
  supportsCli: boolean;
  supportsWorkflows: boolean;
  toolTypes: {
    skills: number;
    mcps: number;
    cli: number;
    workflows: number;
  };
}

type SourceLink = AgentData["sources"][number];

interface ToolCounts {
  skill: number;
  mcp: number;
  cli: number;
  workflow: number;
}

interface Props {
  agent: AgentData;
  counts?: ToolCounts;
}

const { agent, counts } = Astro.props;
const toolCounts = counts ?? {
  skill: agent.toolTypes.skills,
  mcp: agent.toolTypes.mcps,
  cli: agent.toolTypes.cli,
  workflow: agent.toolTypes.workflows,
};
const support = [
  ["MCP", agent.supportsMcp],
  ["Skills", agent.supportsSkills],
  ["CLI", agent.supportsCli],
  ["Workflows", agent.supportsWorkflows],
];
const sourceLinks = agent.sources ?? [];
const primaryOfficial = sourceLinks.find((source) => source.kind === "official") ?? {
  label: "Official docs",
  url: agent.documentationUrl,
  kind: "official" as const,
};
const primaryLinks = [
  primaryOfficial,
  sourceLinks.find((source) => source.kind === "github"),
  sourceLinks.find((source) => source.kind === "docs"),
  sourceLinks.find((source) => source.kind === "quickstart"),
].filter((source): source is SourceLink => Boolean(source))
  .filter((source, index, links) => links.findIndex((item) => item.url === source.url) === index);
---

<article class="profile-card">
  <div class="eyebrow">/{agent.region} agent</div>
  <h1>{agent.name}</h1>
  <p>{agent.summary}</p>

  <div class="meta">
    {agent.vendor && <span>{agent.vendor}</span>}
    {agent.interfaceType.map((type) => <span>{type}</span>)}
  </div>

  <div class="support-grid">
    {support.map(([label, enabled]) => <span class:list={[{ enabled }]}>{label}</span>)}
  </div>

  <div class="official-links" aria-label={`${agent.name} official links`}>
    {primaryLinks.map((source) => (
      <a href={source.url} target="_blank" rel="noreferrer">
        <span>{source.kind}</span>
        <strong>{source.label}</strong>
      </a>
    ))}
  </div>

  <div class="stat-row">
    <div class="stat"><strong>{toolCounts.skill}</strong><span>Skills</span></div>
    <div class="stat"><strong>{toolCounts.mcp}</strong><span>MCPs</span></div>
    <div class="stat"><strong>{toolCounts.cli}</strong><span>CLI</span></div>
    <div class="stat"><strong>{toolCounts.workflow}</strong><span>Workflows</span></div>
  </div>
</article>

<style>
  .profile-card {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgb(238 244 238 / 0.04), rgb(238 244 238 / 0.012)),
      var(--paper);
  }

  h1 {
    font-size: clamp(32px, 4vw, 54px);
  }

  p {
    margin-top: 18px;
    color: var(--muted);
    line-height: 1.75;
  }

  .meta,
  .support-grid,
  .official-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .meta span,
  .support-grid span {
    padding: 7px 9px;
    color: var(--muted);
    font-size: 12px;
    background: rgb(238 244 238 / 0.035);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .support-grid span.enabled {
    color: var(--sage);
    background: var(--sage-soft);
    border-color: rgb(167 207 164 / 0.18);
  }

  .official-links {
    margin-top: 22px;
  }

  .official-links a {
    display: grid;
    gap: 3px;
    min-width: 138px;
    padding: 12px 13px;
    border: 1px solid rgb(159 189 155 / 0.22);
    border-radius: 16px;
    background: rgb(159 189 155 / 0.08);
  }

  .official-links a:hover {
    border-color: rgb(159 189 155 / 0.42);
    background: rgb(159 189 155 / 0.12);
  }

  .official-links span {
    color: var(--sage);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .official-links strong {
    color: var(--ink);
    font-size: 13px;
    line-height: 1.3;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 28px;
  }

  .stat {
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgb(238 244 238 / 0.035);
  }

  .stat strong {
    display: block;
    font-size: 20px;
  }

  .stat span {
    color: var(--muted);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .stat-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
interface DownloadData {
  title: string;
  type: string;
  summary: string;
  fileUrl: string;
}

interface Props {
  download: DownloadData;
}

const { download } = Astro.props;
---

<a class="download-card" href={download.fileUrl}>
  <span class="badge">{download.type}</span>
  <h3>{download.title}</h3>
  <p>{download.summary}</p>
</a>

<style>
  .download-card {
    display: grid;
    gap: 13px;
    min-height: 168px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgb(238 244 238 / 0.04), rgb(238 244 238 / 0.012)),
      var(--paper);
    box-shadow: var(--shadow);
  }

  .badge {
    display: inline-flex;
    width: max-content;
    align-items: center;
    min-height: 26px;
    padding: 0 10px;
    color: var(--clay);
    font-size: 11px;
    font-weight: 700;
    background: var(--clay-soft);
    border: 1px solid rgb(211 154 118 / 0.18);
    border-radius: 999px;
    text-transform: capitalize;
  }

  p {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.65;
  }
</style>

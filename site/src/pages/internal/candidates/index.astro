---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const candidates = (await getCollection("candidates")).sort((a, b) =>
  b.data.discoveredAt.localeCompare(a.data.discoveredAt)
);

const statusCounts = candidates.reduce<Record<string, number>>((counts, candidate) => {
  counts[candidate.data.status] = (counts[candidate.data.status] ?? 0) + 1;
  return counts;
}, {});

const averageScore = (candidate: (typeof candidates)[number]) => {
  const values = Object.values(candidate.data.reviewScore);
  return values.reduce((sum, score) => sum + score, 0) / values.length;
};

const formatStars = (stars?: number) => {
  if (!stars) return "no stars";
  if (stars >= 1000) return `${(stars / 1000).toFixed(stars >= 10000 ? 0 : 1)}k stars`;
  return `${stars} stars`;
};
---

<BaseLayout title="Candidate Pool - agentk.it" description="Internal candidate pool for reviewing and publishing content." noindex>
  <section class="page pool-hero">
    <a class="back" href="/internal">Internal home</a>
    <div class="eyebrow">Candidate Pool</div>
    <h1>Review first. Publish only what earns it.</h1>
    <p>
      Every candidate keeps source, score, notes, permission state, and target
      content type visible before it can move into the public site.
    </p>
    <div class="hero-actions">
      <a class="small-button" href="#queue">Review candidate queue</a>
      <code>npm run discover:github -- --limit 20 --dry-run</code>
    </div>
  </section>

  <section class="page stats">
    {Object.entries(statusCounts).map(([status, count]) => (
      <div>
        <span>{count}</span>
        <p>{status}</p>
      </div>
    ))}
  </section>

  <section class="section page help-panel">
    <div>
      <div class="eyebrow">How this page works</div>
      <h2>Click one candidate, inspect evidence, then publish only after approval.</h2>
    </div>
    <ol>
      <li>Open a candidate row below.</li>
      <li>Check GitHub evidence, README extract, install hints, detected files, score, and permission.</li>
      <li>Use the approve command shown on the detail page when it is ready.</li>
      <li>Run the publish command shown on the candidate detail page.</li>
    </ol>
  </section>

  <section class="section page candidate-list" id="queue">
    {
      candidates.map((candidate) => (
        <a class="candidate-row" href={`/internal/candidates/${candidate.id}`}>
          <div>
            <div class="row-top">
              <span>{candidate.data.type}</span>
              <span>{candidate.data.status}</span>
              <span>score {averageScore(candidate).toFixed(1)}</span>
              <span>{candidate.data.proposedToolType ?? "untyped"}</span>
            </div>
            <h2>{candidate.data.title}</h2>
            <p>{candidate.data.summary}</p>
            <div class="evidence-line">
              <span>{formatStars(candidate.data.githubMetadata?.stars)}</span>
              <span>{candidate.data.permissionStatus ?? candidate.data.githubMetadata?.license ?? "permission unknown"}</span>
              <span>{candidate.data.detectedFiles.length} evidence files</span>
              <span>{candidate.data.extractedInstall.length} install hints</span>
            </div>
          </div>
          <strong>Review / submit</strong>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .pool-hero {
    padding: 72px 0 24px;
  }

  .back {
    display: inline-flex;
    margin-bottom: 22px;
    color: var(--sage);
    font-size: 13px;
  }

  .pool-hero p {
    max-width: 650px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 22px;
  }

  .hero-actions code {
    padding: 10px 12px;
    color: var(--sage);
    font-size: 12px;
    background: rgb(238 244 238 / 0.035);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .stats div {
    min-width: 150px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--paper);
  }

  .stats span {
    color: var(--sage);
    font-size: 30px;
    font-weight: 700;
  }

  .stats p {
    margin-top: 4px;
    color: var(--muted);
    text-transform: capitalize;
  }

  .help-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.75fr);
    gap: 24px;
    align-items: start;
    padding: 24px;
    margin-top: 26px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background:
      radial-gradient(circle at 90% 0%, rgb(167 207 164 / 0.12), transparent 18rem),
      var(--paper);
    box-shadow: var(--shadow);
  }

  .help-panel ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .help-panel code {
    color: var(--sage);
  }

  .candidate-list {
    display: grid;
    gap: 14px;
  }

  .candidate-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px;
    gap: 18px;
    align-items: center;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--paper);
  }

  .candidate-row:hover {
    border-color: var(--line-strong);
  }

  .row-top {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .row-top span {
    padding: 6px 9px;
    color: var(--sage);
    font-size: 11px;
    font-weight: 700;
    background: var(--sage-soft);
    border-radius: 999px;
    text-transform: uppercase;
  }

  .candidate-row p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .candidate-row strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 12px;
    color: #08100b;
    font-size: 12px;
    background: var(--sage);
    border-radius: 999px;
  }

  .evidence-line {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .evidence-line span {
    padding: 6px 9px;
    color: var(--muted);
    font-size: 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  #queue {
    scroll-margin-top: 120px;
  }

  @media (max-width: 760px) {
    .candidate-row,
    .help-panel {
      grid-template-columns: 1fr;
    }
  }
</style>

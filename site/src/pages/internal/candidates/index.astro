---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const candidates = (await getCollection("candidates")).sort((a, b) =>
  b.data.discoveredAt.localeCompare(a.data.discoveredAt)
);

const moduleConfigs = [
  {
    type: "tool",
    label: "Tools",
    title: "Tools Candidates",
    description: "MCP, Skill, CLI, Workflow, SDK, and tool-like repositories. Uses the Tools GitHub crawler only.",
    command: "npm run discover:tools -- --limit 80",
  },
  {
    type: "agent",
    label: "Agents",
    title: "Agent Candidates",
    description: "Agent products, coding assistants, frameworks, official docs, GitHub sources, and ecosystem capability updates.",
    command: "npm run discover:agents -- --limit 20",
  },
  {
    type: "learn",
    label: "Learn",
    title: "Learn Candidates",
    description: "Teaching topics, concept explainers, decision guides, glossary pages, and learning paths.",
    command: "npm run discover:learn -- --limit 20",
  },
  {
    type: "signal",
    label: "Signals",
    title: "Signal Candidates",
    description: "High-quality ecosystem signals, Chinese-to-English translation candidates, releases, and source-backed trends.",
    command: "npm run discover:signals -- --limit 20",
  },
] as const;

const candidatesByType = moduleConfigs.reduce<Record<string, typeof candidates>>((groups, module) => {
  groups[module.type] = candidates.filter((candidate) => candidate.data.type === module.type);
  return groups;
}, {});

const statusCounts = candidates.reduce<Record<string, number>>((counts, candidate) => {
  counts[candidate.data.status] = (counts[candidate.data.status] ?? 0) + 1;
  return counts;
}, {});

const averageScore = (candidate: (typeof candidates)[number]) => {
  const values = Object.values(candidate.data.reviewScore);
  return values.reduce((sum, score) => sum + score, 0) / values.length;
};

const formatStars = (stars?: number) => {
  if (!stars) return "no stars";
  if (stars >= 1000) return `${(stars / 1000).toFixed(stars >= 10000 ? 0 : 1)}k stars`;
  return `${stars} stars`;
};

const formatCategories = (categories?: string[]) => {
  if (!categories?.length) return "no use category";
  return categories.slice(0, 4).join(", ");
};

const routeFor = (candidate: (typeof candidates)[number]) =>
  candidate.data.toolProfile?.routingDecision ?? candidate.data.routingDecision ?? "review_required";

const enrichmentFor = (candidate: (typeof candidates)[number]) =>
  candidate.data.enrichmentDecision ?? "not_enriched";

const profileTagsFor = (candidate: (typeof candidates)[number]) => {
  if (candidate.data.type === "tool") {
    const profile = candidate.data.toolProfile;
    return [
      profile?.capabilityType ?? candidate.data.capabilityType ?? candidate.data.proposedToolType ?? "untyped",
      profile?.scope ?? candidate.data.scope ?? "scope unknown",
      profile?.confidence ?? candidate.data.classificationConfidence ?? "confidence unknown",
      routeFor(candidate),
      enrichmentFor(candidate),
    ];
  }

  if (candidate.data.type === "agent") {
    const profile = candidate.data.agentProfile;
    return [
      profile?.region ?? "region unknown",
      profile?.interfaceType?.join(", ") || "interface unknown",
      profile?.supportsMcp ? "MCP" : "MCP unknown",
      profile?.supportsSkills ? "Skills" : "Skills unknown",
    ];
  }

  if (candidate.data.type === "learn") {
    const profile = candidate.data.learnProfile;
    return [
      profile?.topic ?? "topic unknown",
      profile?.path ?? "path unknown",
      profile?.difficulty ?? "difficulty unknown",
      profile?.readingTime ?? "reading time unknown",
    ];
  }

  const profile = candidate.data.signalProfile;
  return [
    profile?.sourceName ?? candidate.data.sourceName ?? "source unknown",
    profile?.permissionStatus ?? candidate.data.permissionStatus ?? "permission unknown",
    profile?.translationMode ?? "full_english_translation",
  ];
};

const evidenceTagsFor = (candidate: (typeof candidates)[number]) => {
  if (candidate.data.type === "tool") {
    return [
      formatStars(candidate.data.githubMetadata?.stars),
      candidate.data.permissionStatus ?? candidate.data.githubMetadata?.license ?? "permission unknown",
      formatCategories(candidate.data.toolProfile?.useCategory ?? candidate.data.useCategory),
      `${candidate.data.detectedFiles.length} evidence files`,
      `${candidate.data.extractedSignals.length} capability signals`,
    ];
  }

  if (candidate.data.type === "agent") {
    const profile = candidate.data.agentProfile;
    return [
      profile?.vendor ?? candidate.data.author ?? "vendor unknown",
      profile?.sourceKinds?.join(", ") || "source kind unknown",
      `${candidate.data.extractedSignals.length} capability signals`,
    ];
  }

  if (candidate.data.type === "learn") {
    const profile = candidate.data.learnProfile;
    return [
      `${profile?.relatedTools?.length ?? 0} related tools`,
      `${profile?.relatedAgents?.length ?? 0} related agents`,
      `${candidate.data.extractedSignals.length} teaching signals`,
    ];
  }

  const profile = candidate.data.signalProfile;
  return [
    profile?.originalPublishedAt ? `published ${profile.originalPublishedAt}` : "source date unknown",
    `${profile?.relatedTools?.length ?? 0} related tools`,
    `${profile?.relatedAgents?.length ?? 0} related agents`,
    `${candidate.data.extractedSignals.length} signal notes`,
  ];
};

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const publicHref = (candidate: (typeof candidates)[number]) => {
  const publishedId = candidate.data.publishedAs || slugify(candidate.data.title);
  if (candidate.data.type === "agent") return `/for/${publishedId}`;
  if (candidate.data.type === "learn") return `/learn/${publishedId}`;
  if (candidate.data.type === "signal") return `/signals/${publishedId}`;
  return `/item/${publishedId}`;
};

const isPublished = (candidate: (typeof candidates)[number]) => candidate.data.status === "published";

const canPublishNow = (candidate: (typeof candidates)[number]) => {
  if (isPublished(candidate) || ["rejected", "archived"].includes(candidate.data.status)) return false;
  const decision = candidate.data.enrichmentDecision;
  if (["reject_not_tool", "reject_low_signal", "route_to_learn", "route_to_signal"].includes(decision ?? "")) return false;
  return ["tool", "agent", "learn", "signal"].includes(candidate.data.type);
};

type CandidateEntry = (typeof candidates)[number];

const dateKeyFor = (candidate: CandidateEntry) => candidate.data.discoveredAt || candidate.data.lastChecked || "unknown-date";

const groupedByDiscoveredDate = (items: CandidateEntry[]) => {
  const groups = new Map<string, CandidateEntry[]>();
  for (const item of items) {
    const key = dateKeyFor(item);
    groups.set(key, [...(groups.get(key) ?? []), item]);
  }
  return [...groups.entries()].map(([date, entries]) => ({ date, entries }));
};

const statusSummaryFor = (items: CandidateEntry[]) => {
  const counts = items.reduce<Record<string, number>>((summary, item) => {
    summary[item.data.status] = (summary[item.data.status] ?? 0) + 1;
    return summary;
  }, {});
  return Object.entries(counts)
    .map(([status, count]) => `${count} ${status}`)
    .join(" · ");
};
---

<BaseLayout title="Candidate Pool - To Play Claw" description="Internal candidate pool for reviewing and publishing content." noindex>
  <section class="page pool-hero">
    <a class="back" href="/internal">Internal home</a>
    <div class="eyebrow">Candidate Pool</div>
    <h1>Review first. Publish only what earns it.</h1>
    <p>
      Every candidate keeps source, score, capability signals, permission state,
      and target content type visible before it can move into the public site.
    </p>
    <div class="hero-actions">
      <a class="small-button" href="#tool">Review module queues</a>
      <code>npm run discover:tools -- --limit 80</code>
    </div>
  </section>

  <section class="page stats">
    {moduleConfigs.map((module) => (
      <a href={`#${module.type}`}>
        <span>{candidatesByType[module.type]?.length ?? 0}</span>
        <p>{module.label}</p>
      </a>
    ))}
    {Object.entries(statusCounts).map(([status, count]) => (
      <div>
        <span>{count}</span>
        <p>{status}</p>
      </div>
    ))}
  </section>

  <section class="section page help-panel">
    <div>
      <div class="eyebrow">How this page works</div>
      <h2>Each module has its own collector, fields, and review lane.</h2>
    </div>
    <ol>
      <li>Tools use the GitHub tools crawler and tool-only capability classification.</li>
      <li>Agents, Learn, and Signals use separate collectors and profile fields.</li>
      <li>Click <code>Publish now</code> only after the module-specific evidence makes sense.</li>
    </ol>
  </section>

  {
    moduleConfigs.map((module) => {
      const moduleCandidates = candidatesByType[module.type] ?? [];
      const dateGroups = groupedByDiscoveredDate(moduleCandidates);
      return (
        <section class="section page module-queue" id={module.type}>
          <div class="module-head">
            <div>
              <div class="eyebrow">{module.label} queue</div>
              <h2>{module.title}</h2>
              <p>{module.description}</p>
            </div>
            <code>{module.command}</code>
          </div>

          <div class="candidate-list">
            {moduleCandidates.length === 0 && (
              <article class="empty-row">
                <h3>No {module.label.toLowerCase()} candidates yet.</h3>
                <p>Run this module's collector when you are ready to fill this queue.</p>
              </article>
            )}

            {dateGroups.map((group) => (
              <section class="date-group" id={`${module.type}-${group.date}`}>
                <header class="date-head">
                  <div>
                    <span>Discovered</span>
                    <h3>{group.date}</h3>
                  </div>
                  <p>{group.entries.length} candidates · {statusSummaryFor(group.entries)}</p>
                </header>

                <div class="date-list">
                  {group.entries.map((candidate) => (
                    <article class:list={["candidate-row", { "is-published": isPublished(candidate) }]} id={candidate.id}>
                      <a class="candidate-main" href={`/internal/candidates/${candidate.id}`}>
                        <div class="row-top">
                          <span>{candidate.data.type}</span>
                          <span>{candidate.data.status}</span>
                          <span>score {averageScore(candidate).toFixed(1)}</span>
                          <span class={`enrich-${enrichmentFor(candidate)}`}>{enrichmentFor(candidate)}</span>
                          {profileTagsFor(candidate).map((tag) => (
                            <span class={tag === routeFor(candidate) ? `route-${routeFor(candidate)}` : undefined}>{tag}</span>
                          ))}
                        </div>
                        <h2>{candidate.data.title}</h2>
                        <p>{candidate.data.summary}</p>
                        {candidate.data.enrichment?.whatIsIt && <p class="enrichment-line">{candidate.data.enrichment.whatIsIt}</p>}
                        <div class="evidence-line">
                          {evidenceTagsFor(candidate).map((tag) => <span>{tag}</span>)}
                        </div>
                      </a>
                      <div class="row-actions">
                        <a href={`/internal/candidates/${candidate.id}`}>Review</a>
                        {
                          isPublished(candidate) ? (
                            <a class="published-link" href={publicHref(candidate)}>
                              Published
                            </a>
                          ) : canPublishNow(candidate) ? (
                            <button
                              class="publish-button"
                              type="button"
                              data-publish-candidate={candidate.id}
                              data-public-href={publicHref(candidate)}
                            >
                              Publish now
                            </button>
                          ) : (
                            <button class="publish-button muted" type="button" disabled>
                              Not publishable
                            </button>
                          )
                        }
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<script>
  const getCookie = (name: string) =>
    document.cookie
      .split(";")
      .map((cookie) => cookie.trim())
      .find((cookie) => cookie.startsWith(`${name}=`))
      ?.slice(name.length + 1) || "";

  const publishCandidate = async (button: HTMLButtonElement) => {
    const candidateId = button.dataset.publishCandidate;
    const publicHref = button.dataset.publicHref;
    const originalText = button.textContent;

    button.disabled = true;
    button.textContent = "Publishing...";
    button.closest(".candidate-row")?.querySelector("[data-publish-status]")?.remove();

    try {
      const response = await fetch("/internal-api/publish-candidate", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": decodeURIComponent(getCookie("agentkit_internal_csrf")),
        },
        body: JSON.stringify({ candidateId }),
      });
      const rawBody = await response.text();
      let result: { ok?: boolean; error?: string } = {};
      try {
        result = rawBody ? JSON.parse(rawBody) : {};
      } catch {
        result = {};
      }

      if (!response.ok || !result.ok) {
        throw new Error(result.error || "Publish API is not available. Restart npm run dev and try again.");
      }

      button.textContent = "Published";
      button.classList.add("published");

      const status = document.createElement("a");
      status.dataset.publishStatus = "true";
      status.className = "published-link";
      if (publicHref) status.href = publicHref;
      status.textContent = "Open public page";
      button.after(status);
    } catch (error) {
      button.disabled = false;
      button.textContent = originalText || "Publish now";

      const status = document.createElement("p");
      status.dataset.publishStatus = "true";
      status.className = "publish-error";
      status.textContent = error instanceof Error ? error.message : "Publish API is not available. Restart npm run dev and try again.";
      button.after(status);
    }
  };

  document.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest("[data-publish-candidate]") : null;
    if (!(button instanceof HTMLButtonElement)) return;
    event.preventDefault();
    void publishCandidate(button);
  });
</script>

<style>
  .pool-hero {
    padding: 72px 0 24px;
  }

  .back {
    display: inline-flex;
    margin-bottom: 22px;
    color: var(--sage);
    font-size: 13px;
  }

  .pool-hero p {
    max-width: 650px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 22px;
  }

  .hero-actions code {
    padding: 10px 12px;
    color: var(--sage);
    font-size: 12px;
    background: rgb(238 244 238 / 0.035);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .stats div,
  .stats a {
    min-width: 150px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--paper);
  }

  .stats span {
    color: var(--sage);
    font-size: 30px;
    font-weight: 700;
  }

  .stats p {
    margin-top: 4px;
    color: var(--muted);
    text-transform: capitalize;
  }

  .help-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.75fr);
    gap: 24px;
    align-items: start;
    padding: 24px;
    margin-top: 26px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background:
      radial-gradient(circle at 90% 0%, rgb(167 207 164 / 0.12), transparent 18rem),
      var(--paper);
    box-shadow: var(--shadow);
  }

  .help-panel ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .help-panel code {
    color: var(--sage);
  }

  .module-queue {
    scroll-margin-top: 120px;
  }

  .module-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.52fr);
    gap: 18px;
    align-items: end;
    margin-bottom: 18px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background:
      radial-gradient(circle at 100% 0%, rgb(167 207 164 / 0.1), transparent 18rem),
      var(--paper);
  }

  .module-head p {
    max-width: 680px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .module-head code {
    display: block;
    padding: 12px 14px;
    overflow: auto;
    color: var(--sage);
    font-size: 12px;
    background: var(--sage-soft);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .candidate-list {
    display: grid;
    gap: 20px;
  }

  .empty-row {
    padding: 22px;
    border: 1px dashed var(--line);
    border-radius: 24px;
    background: rgb(238 244 238 / 0.018);
  }

  .empty-row p {
    margin-top: 8px;
    color: var(--muted);
  }

  .candidate-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: 18px;
    align-items: center;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--paper);
  }

  .date-group {
    display: grid;
    gap: 12px;
    scroll-margin-top: 120px;
  }

  .date-head {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: end;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background:
      linear-gradient(90deg, rgb(167 207 164 / 0.08), transparent),
      rgb(238 244 238 / 0.025);
  }

  .date-head span {
    color: var(--sage);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .date-head h3 {
    margin-top: 4px;
    color: var(--ink);
    font-size: 22px;
    letter-spacing: -0.04em;
  }

  .date-head p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    text-align: right;
    text-transform: capitalize;
  }

  .date-list {
    display: grid;
    gap: 12px;
  }

  .candidate-main {
    display: block;
  }

  .candidate-row:hover {
    border-color: var(--line-strong);
  }

  .row-top {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .row-top span {
    padding: 6px 9px;
    color: var(--sage);
    font-size: 11px;
    font-weight: 700;
    background: var(--sage-soft);
    border-radius: 999px;
    text-transform: uppercase;
  }

  .row-top .route-auto_publish {
    color: #111811;
    background: var(--sage);
  }

  .row-top .route-review_required {
    color: var(--clay);
    background: rgb(225 166 122 / 0.12);
  }

  .row-top .route-auto_reject {
    color: var(--faint);
    background: rgb(238 244 238 / 0.05);
  }

  .row-top .enrich-ready_to_publish {
    color: #111811;
    background: var(--sage);
  }

  .row-top .enrich-needs_editor_review {
    color: var(--clay);
    background: rgb(225 166 122 / 0.12);
  }

  .row-top .enrich-route_to_learn,
  .row-top .enrich-route_to_signal {
    color: #c9d8ff;
    background: rgb(135 165 255 / 0.12);
  }

  .row-top .enrich-reject_not_tool,
  .row-top .enrich-reject_low_signal {
    color: var(--faint);
    background: rgb(238 244 238 / 0.05);
  }

  .candidate-row p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .candidate-row .enrichment-line {
    color: var(--ink);
  }

  .row-actions {
    display: grid;
    gap: 10px;
  }

  .row-actions a,
  .publish-button,
  .published-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 999px;
  }

  .row-actions a {
    color: var(--sage);
    border: 1px solid var(--line);
  }

  .publish-button,
  .published-link {
    color: #111811;
    font-size: 12px;
    background: var(--sage);
    border: 0;
  }

  .publish-button.published {
    background: var(--clay);
  }

  .publish-button.muted {
    color: var(--faint);
    background: rgb(238 244 238 / 0.06);
  }

  .evidence-line {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .evidence-line span {
    padding: 6px 9px;
    color: var(--muted);
    font-size: 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  #queue {
    scroll-margin-top: 120px;
  }

  .publish-error {
    color: var(--clay);
    font-size: 12px;
    line-height: 1.4;
  }

  @media (max-width: 760px) {
    .candidate-row,
    .help-panel,
    .module-head {
      grid-template-columns: 1fr;
    }

    .date-head {
      align-items: start;
      flex-direction: column;
    }

    .date-head p {
      text-align: left;
    }
  }
</style>

---
import { getCollection } from "astro:content";
import AgentSummary from "../../components/AgentSummary.astro";
import ToolListItem from "../../components/ToolListItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortToolsByNewest } from "../../lib/filters";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  return agents
    .filter((agent) => agent.data.status === "published")
    .map((agent) => ({
      params: { agent: agent.data.id },
      props: { agent },
    }));
}

const { agent } = Astro.props;
const tools = sortToolsByNewest(
  (await getCollection("tools")).filter(
    (tool) => tool.data.status === "published" && tool.data.compatibleAgents.includes(agent.data.name),
  ),
);
---

<BaseLayout title={`${agent.data.name} tools - agentk.it`} description={agent.data.summary}>
  <section class="agent-profile page">
    <AgentSummary agent={agent.data} />
    <section class="tool-panel">
      <div class="section-head">
        <div>
          <div class="eyebrow">Compatible tools</div>
          <h2>{tools.length} tools mapped to {agent.data.name}</h2>
        </div>
      </div>
      <div class="list">
        {tools.map((tool) => <ToolListItem tool={tool.data} />)}
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .agent-profile {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 24px;
    padding: 58px 0;
  }

  .tool-panel {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgb(238 244 238 / 0.035), rgb(238 244 238 / 0.01)),
      var(--paper);
  }

  .list {
    display: grid;
    gap: 14px;
  }

  @media (max-width: 960px) {
    .agent-profile {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolListItem from "../../components/ToolListItem.astro";

export async function getStaticPaths() {
  const articles = (await getCollection("learn")).filter((entry) => entry.data.status === "published");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const tools = (await getCollection("tools")).filter((tool) => article.data.relatedTools.includes(tool.data.id));
const agents = (await getCollection("agents")).filter((agent) => article.data.relatedAgents.includes(agent.data.id));
const nextReads = (await getCollection("learn"))
  .filter((entry) => article.data.nextReads.includes(entry.id) && entry.data.status === "published")
  .sort((a, b) => article.data.nextReads.indexOf(a.id) - article.data.nextReads.indexOf(b.id));
const toolById = new Map(tools.map((tool) => [tool.data.id, tool]));
const agentById = new Map(agents.map((agent) => [agent.data.id, agent]));
---

<BaseLayout title={`${article.data.title} - agentk.it`} description={article.data.subtitle}>
  <article class="page article-shell">
    <a class="back" href="/learn">Back to Learn</a>
    <div class="eyebrow">{article.data.topic} · {article.data.difficulty} · {article.data.readingTime}</div>
    <h1>{article.data.title}</h1>
    <p class="dek">{article.data.subtitle}</p>

    {
      article.data.summaryBullets.length > 0 && (
        <aside class="learn-box">
          <strong>Quick takeaways</strong>
          <ul>
            {article.data.summaryBullets.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      (article.data.coreIdea ||
        article.data.useWhen.length > 0 ||
        article.data.avoidWhen.length > 0 ||
        article.data.checklist.length > 0 ||
        article.data.examples.length > 0 ||
        article.data.mistakes.length > 0 ||
        article.data.nextStep) && (
        <section class="decision-layer" aria-label="Decision guide">
          {article.data.coreIdea && (
            <article class="decision-card core">
              <div class="eyebrow">Core idea</div>
              <p>{article.data.coreIdea}</p>
            </article>
          )}

          {(article.data.useWhen.length > 0 || article.data.avoidWhen.length > 0) && (
            <div class="use-avoid-grid">
              {article.data.useWhen.length > 0 && (
                <article class="decision-card">
                  <div class="eyebrow">Use when</div>
                  <ul>{article.data.useWhen.map((item) => <li>{item}</li>)}</ul>
                </article>
              )}
              {article.data.avoidWhen.length > 0 && (
                <article class="decision-card clay">
                  <div class="eyebrow">Avoid when</div>
                  <ul>{article.data.avoidWhen.map((item) => <li>{item}</li>)}</ul>
                </article>
              )}
            </div>
          )}

          {article.data.checklist.length > 0 && (
            <article class="decision-card">
              <div class="eyebrow">What to check</div>
              <div class="checklist">
                {article.data.checklist.map((item, index) => (
                  <div>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{item.label}</strong>
                    <p>{item.body}</p>
                  </div>
                ))}
              </div>
            </article>
          )}

          {article.data.examples.length > 0 && (
            <article class="decision-card">
              <div class="eyebrow">Try it with</div>
              <div class="example-grid">
                {article.data.examples.map((example) => {
                  const exampleTools = example.toolIds.map((id) => toolById.get(id)).filter(Boolean);
                  const exampleAgents = example.agentIds.map((id) => agentById.get(id)).filter(Boolean);
                  return (
                    <div class="example-card">
                      <h3>{example.title}</h3>
                      <p>{example.body}</p>
                      {(exampleTools.length > 0 || exampleAgents.length > 0) && (
                        <div class="example-links">
                          {exampleAgents.map((agent) => <a href={`/for/${agent!.data.id}`}>{agent!.data.name}</a>)}
                          {exampleTools.map((tool) => <a href={`/item/${tool!.data.id}`}>{tool!.data.name}</a>)}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </article>
          )}

          {article.data.mistakes.length > 0 && (
            <article class="decision-card clay">
              <div class="eyebrow">Watchouts</div>
              <ul>{article.data.mistakes.map((item) => <li>{item}</li>)}</ul>
            </article>
          )}

          {article.data.nextStep && (
            <article class="decision-card next-step">
              <div class="eyebrow">Next step</div>
              <p>{article.data.nextStep}</p>
            </article>
          )}
        </section>
      )
    }
  </article>

  {
    agents.length > 0 && (
      <section class="section page related-section">
        <div class="section-head">
          <div>
            <div class="eyebrow">Related agents</div>
            <h2>Use this concept with real Agent pages.</h2>
          </div>
        </div>
        <div class="agent-chip-row">
          {agents.map((agent) => <a href={`/for/${agent.data.id}`}>{agent.data.name}</a>)}
        </div>
      </section>
    )
  }

  {
    tools.length > 0 && (
      <section class="section page related-section">
        <div class="section-head">
          <div>
            <div class="eyebrow">Related tools</div>
            <h2>Try this with actual tools.</h2>
          </div>
        </div>
        <div class="stack">
          {tools.map((tool) => <ToolListItem tool={tool.data} />)}
        </div>
      </section>
    )
  }

  {
    nextReads.length > 0 && (
      <section class="section page related-section">
        <div class="section-head">
          <div>
            <div class="eyebrow">Next reads</div>
            <h2>Keep moving through the path.</h2>
          </div>
        </div>
        <div class="next-grid">
          {nextReads.map((entry) => (
            <a href={`/learn/${entry.id}`}>
              <span>{entry.data.topic} · {entry.data.readingTime}</span>
              <strong>{entry.data.title}</strong>
              <p>{entry.data.subtitle}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 12% 0%, rgb(134 174 255 / 0.18), transparent 30rem),
      radial-gradient(circle at 88% 7%, rgb(229 183 106 / 0.13), transparent 28rem),
      radial-gradient(circle at 60% 86%, rgb(82 220 160 / 0.12), transparent 34rem),
      #080b10;
  }

  .article-shell {
    max-width: 920px;
    padding: 52px 0 30px;
  }

  .back {
    display: inline-flex;
    margin-bottom: 18px;
    color: #8fb7ff;
    font-size: 13px;
  }

  .eyebrow {
    color: #e5b76a;
  }

  .article-shell h1 {
    max-width: 880px;
    margin-top: 16px;
    color: #f6f2ea;
    font-size: clamp(48px, 7vw, 92px);
    line-height: 0.9;
    letter-spacing: -0.085em;
  }

  .dek {
    max-width: 740px;
    margin-top: 20px;
    color: #aeb7c8;
    font-size: 17px;
    line-height: 1.66;
  }

  .learn-box,
  .prose,
  .decision-card,
  .checklist div,
  .example-card,
  .next-grid a {
    border: 1px solid rgb(246 242 234 / 0.11);
    background:
      linear-gradient(180deg, rgb(246 242 234 / 0.07), rgb(246 242 234 / 0.026)),
      rgb(12 17 24 / 0.82);
    box-shadow: 0 30px 100px rgb(0 0 0 / 0.26);
    backdrop-filter: blur(30px);
  }

  .learn-box {
    margin-top: 26px;
    padding: 20px 22px;
    border-radius: 26px;
  }

  .learn-box strong,
  .decision-card .eyebrow,
  .next-grid span {
    color: #e5b76a;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .learn-box ul {
    display: grid;
    gap: 8px;
    margin-top: 14px;
    padding-left: 18px;
  }

  .learn-box li {
    color: #aeb7c8;
    line-height: 1.62;
  }

  .prose {
    margin-top: 28px;
    padding: 30px;
    color: #aeb7c8;
    border-radius: 30px;
  }

  .prose :global(h2) {
    margin-top: 32px;
    color: #f6f2ea;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .prose :global(p),
  .prose :global(li) {
    font-size: 15.5px;
    line-height: 1.82;
  }

  .prose :global(a) {
    color: #8fb7ff;
  }

  .decision-layer {
    display: grid;
    gap: 14px;
    margin-top: 20px;
  }

  .decision-card {
    padding: 20px;
    border-radius: 24px;
  }

  .decision-card.core {
    border-color: rgb(82 220 160 / 0.22);
    background:
      linear-gradient(135deg, rgb(82 220 160 / 0.1), rgb(246 242 234 / 0.026)),
      rgb(12 17 24 / 0.82);
  }

  .decision-card.clay {
    border-color: rgb(229 183 106 / 0.2);
    background:
      linear-gradient(135deg, rgb(229 183 106 / 0.1), rgb(246 242 234 / 0.026)),
      rgb(12 17 24 / 0.82);
  }

  .decision-card p,
  .decision-card li {
    color: #aeb7c8;
    font-size: 14px;
    line-height: 1.7;
  }

  .decision-card ul {
    display: grid;
    gap: 8px;
    margin-top: 12px;
    padding-left: 18px;
  }

  .use-avoid-grid,
  .example-grid,
  .next-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .checklist {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .checklist div,
  .example-card {
    padding: 15px;
    border-radius: 18px;
    box-shadow: none;
  }

  .checklist span {
    color: #8fb7ff;
    font-size: 12px;
    font-weight: 900;
  }

  .checklist strong,
  .example-card h3 {
    display: block;
    margin-top: 5px;
    color: #f6f2ea;
  }

  .checklist p,
  .example-card p {
    margin-top: 7px;
  }

  .example-links,
  .agent-chip-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .example-links a,
  .agent-chip-row a {
    padding: 8px 10px;
    color: #bbf2d9;
    font-size: 12px;
    font-weight: 800;
    border: 1px solid rgb(82 220 160 / 0.22);
    border-radius: 999px;
    background: rgb(82 220 160 / 0.08);
  }

  .next-step {
    display: grid;
    gap: 10px;
  }

  .related-section {
    max-width: 1000px;
  }

  .stack {
    display: grid;
    gap: 14px;
  }

  .next-grid a {
    display: grid;
    gap: 10px;
    padding: 20px;
    border-radius: 24px;
  }

  .next-grid strong {
    color: #f6f2ea;
    font-size: 20px;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .next-grid p {
    color: #aeb7c8;
    font-size: 13px;
    line-height: 1.62;
  }

  @media (max-width: 760px) {
    .next-grid,
    .use-avoid-grid,
    .example-grid {
      grid-template-columns: 1fr;
    }

    .article-shell h1 {
      font-size: clamp(42px, 13vw, 64px);
    }
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { agentMatchesTool } from "../../lib/agent-compatibility.mjs";

const agents = (await getCollection("agents"))
  .filter((agent) => agent.data.status === "published")
  .sort((a, b) => a.data.region.localeCompare(b.data.region) || a.data.name.localeCompare(b.data.name));

const tools = (await getCollection("tools")).filter((tool) => tool.data.status === "published");
const mappedTools = (agent: (typeof agents)[number]) =>
  tools.filter((tool) => agentMatchesTool(agent.data, tool.data)).length;

const globalAgents = agents.filter((agent) => agent.data.region === "global").length;
const chinaAgents = agents.filter((agent) => agent.data.region === "china").length;
const totalMappedTools = agents.reduce((count, agent) => count + mappedTools(agent), 0);

const pipeline = [
  { label: "agents", value: agents.length, detail: "published profiles" },
  { label: "global", value: globalAgents, detail: "international agents" },
  { label: "china", value: chinaAgents, detail: "China-origin agents" },
  { label: "mapped", value: totalMappedTools, detail: "agent-tool links" },
];
---

<BaseLayout
  title="Agents - 2playclaw.com"
  description="Browse AI agents as compatibility maps for Skills, MCPs, CLI tools, and Workflows."
>
  <section class="agents page">
    <section class="hero">
      <div class="hero-copy">
        <div class="route-chip"><span></span>Agent Compatibility Atlas</div>
        <h1>Use agents as the map layer, not the whole directory.</h1>
        <p>
          Start from the tool category, then open an Agent page to see which Skills,
          MCP servers, CLI tools, and Workflows fit that execution surface.
        </p>
      </div>

      <aside class="lab-console">
        <div class="console-head">
          <span>Compatibility lab</span>
          <strong>Agent map</strong>
        </div>
        <div class="console-lines">
          {pipeline.map((item) => (
            <div>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <p>{item.detail}</p>
            </div>
          ))}
        </div>
      </aside>
    </section>

    <section class="agent-section">
      <div class="section-kicker">
        <span>01</span>
        <h2>Choose the surface you work in.</h2>
        <p>
          Each Agent page is a compatibility sheet: capabilities, official sources,
          mapped tools, and related learning pages.
        </p>
      </div>

      <div class="agent-matrix">
        {
          agents.map((agent) => {
            const count = mappedTools(agent);
            return (
              <a class="agent-card" href={`/for/${agent.data.id}`}>
                <div class="card-top">
                  <span>{agent.data.region}</span>
                  {agent.data.vendor && <span>{agent.data.vendor}</span>}
                </div>
                <h2>{agent.data.name}</h2>
                <p>{agent.data.summary}</p>
                <div class="support">
                  {agent.data.supportsMcp && <span>MCP</span>}
                  {agent.data.supportsSkills && <span>Skills</span>}
                  {agent.data.supportsCli && <span>CLI</span>}
                  {agent.data.supportsWorkflows && <span>Workflows</span>}
                </div>
                <div class="metric">
                  <strong>{count}</strong>
                  <span>{count === 1 ? "mapped tool" : "mapped tools"}</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 12% 0%, rgb(134 174 255 / 0.2), transparent 30rem),
      radial-gradient(circle at 90% 8%, rgb(229 183 106 / 0.14), transparent 28rem),
      radial-gradient(circle at 58% 88%, rgb(82 220 160 / 0.12), transparent 34rem),
      #080b10;
  }

  .agents {
    padding: 42px 0 68px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.32fr) minmax(320px, 0.68fr);
    gap: 18px;
  }

  .hero-copy,
  .lab-console,
  .agent-card {
    border: 1px solid rgb(246 242 234 / 0.11);
    background:
      linear-gradient(180deg, rgb(246 242 234 / 0.07), rgb(246 242 234 / 0.026)),
      rgb(12 17 24 / 0.82);
    box-shadow: 0 30px 100px rgb(0 0 0 / 0.32);
    backdrop-filter: blur(30px);
  }

  .hero-copy {
    position: relative;
    min-height: 330px;
    padding: clamp(28px, 4.4vw, 52px);
    overflow: hidden;
    border-radius: 42px;
  }

  .hero-copy::after {
    position: absolute;
    right: -80px;
    bottom: -140px;
    width: 350px;
    height: 350px;
    content: "";
    background:
      radial-gradient(circle at 34% 35%, rgb(246 242 234 / 0.72), transparent 8%),
      conic-gradient(from 180deg, rgb(134 174 255 / 0.62), rgb(229 183 106 / 0.42), rgb(82 220 160 / 0.46), rgb(134 174 255 / 0.62));
    border-radius: 44% 56% 50% 50%;
    opacity: 0.62;
    filter: blur(4px);
  }

  .route-chip {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    padding: 9px 12px;
    color: #d9e6ff;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    border: 1px solid rgb(134 174 255 / 0.26);
    border-radius: 999px;
    background: rgb(134 174 255 / 0.1);
  }

  .route-chip span {
    width: 8px;
    height: 8px;
    background: #e5b76a;
    border-radius: 999px;
  }

  .hero h1 {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin-top: 24px;
    color: #f6f2ea;
    font-size: clamp(44px, 6.4vw, 82px);
    line-height: 0.9;
    letter-spacing: -0.08em;
  }

  .hero p {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin-top: 22px;
    color: #aeb7c8;
    font-size: 16px;
    line-height: 1.66;
  }

  .lab-console {
    display: grid;
    align-content: space-between;
    min-height: 330px;
    padding: 24px;
    border-radius: 34px;
  }

  .console-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #9aa4b6;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  .console-head strong {
    color: #e5b76a;
  }

  .console-lines {
    display: grid;
    gap: 10px;
  }

  .console-lines div {
    display: grid;
    grid-template-columns: 76px 70px minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
    padding-top: 12px;
    border-top: 1px solid rgb(246 242 234 / 0.1);
  }

  .console-lines span,
  .console-lines p {
    color: #8c96a7;
    font-size: 12px;
  }

  .console-lines strong {
    color: #f6f2ea;
    font-size: 24px;
    letter-spacing: -0.04em;
  }

  .agent-section {
    margin-top: 44px;
  }

  .section-kicker {
    display: grid;
    grid-template-columns: 46px minmax(0, 0.8fr) minmax(260px, 0.6fr);
    gap: 18px;
    align-items: end;
    margin-bottom: 18px;
  }

  .section-kicker > span {
    color: #e5b76a;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .section-kicker h2 {
    color: #f6f2ea;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .section-kicker p {
    color: #9aa4b6;
    font-size: 14px;
    line-height: 1.62;
  }

  .agent-matrix {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .agent-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    min-height: 295px;
    padding: 22px;
    border-radius: 28px;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .agent-card:hover {
    border-color: rgb(134 174 255 / 0.34);
    background:
      linear-gradient(180deg, rgb(134 174 255 / 0.1), rgb(246 242 234 / 0.026)),
      rgb(12 17 24 / 0.88);
    transform: translateY(-3px);
  }

  .card-top,
  .support {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .card-top span,
  .support span {
    padding: 7px 9px;
    color: #9aa4b6;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid rgb(246 242 234 / 0.12);
    border-radius: 999px;
    background: rgb(246 242 234 / 0.045);
  }

  .support span {
    color: #bbf2d9;
    border-color: rgb(82 220 160 / 0.22);
    background: rgb(82 220 160 / 0.08);
  }

  .agent-card h2 {
    margin-top: 28px;
    color: #f6f2ea;
    font-size: clamp(30px, 3.3vw, 48px);
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .agent-card p {
    margin-top: 14px;
    color: #a9b2c1;
    font-size: 14px;
    line-height: 1.62;
  }

  .metric {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgb(246 242 234 / 0.1);
  }

  .metric strong {
    color: #8fb7ff;
    font-size: 28px;
    letter-spacing: -0.04em;
  }

  .metric span {
    color: #8c96a7;
    font-size: 12px;
  }

  @media (max-width: 980px) {
    .hero,
    .section-kicker,
    .agent-matrix {
      grid-template-columns: 1fr;
    }

    .hero-copy,
    .lab-console {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .agents {
      padding-top: 24px;
    }

    .hero-copy,
    .lab-console,
    .agent-card {
      border-radius: 26px;
    }

    .console-lines div {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedTools, sortToolsByNewest } from "../../lib/filters";

const tools = sortToolsByNewest(getPublishedTools(await getCollection("tools"))).map((tool) => tool.data);

// ── Pagination ──
const perPage = 20;
const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const totalPages = Math.ceil(tools.length / perPage);
const pageTools = tools.slice((page - 1) * perPage, page * perPage);

const typeCounts = tools.reduce<Record<string, number>>((counts, tool) => {
  counts[tool.type] = (counts[tool.type] ?? 0) + 1;
  return counts;
}, {});

const categoryList = ["devops", "automation", "data", "security", "communication", "productivity"];
const categoryCounts = Object.fromEntries(
  categoryList.map((slug) => [slug, tools.filter((tool) => tool.category.includes(slug)).length]),
);

const aiCategories = [
  { title: "AI Coding Tools", href: "/category/devops", count: categoryCounts.devops, tone: "blue", sub: ["Repo analysis", "Code review", "Terminal agents"] },
  { title: "AI Automation Tools", href: "/category/automation", count: categoryCounts.automation, tone: "amber", sub: ["Workflows", "Connectors", "Agent actions"] },
  { title: "AI Data & RAG Tools", href: "/category/data", count: categoryCounts.data, tone: "green", sub: ["Database", "Search", "Knowledge base"] },
  { title: "AI Security Tools", href: "/category/security", count: categoryCounts.security, tone: "rose", sub: ["Scanning", "Sandbox", "Auth"] },
  { title: "AI Communication Tools", href: "/category/communication", count: categoryCounts.communication, tone: "violet", sub: ["Slack", "Email", "Calendar"] },
  { title: "AI Productivity Tools", href: "/category/productivity", count: categoryCounts.productivity, tone: "mint", sub: ["Research", "Notes", "Tasks"] },
];
---

<BaseLayout title="Tools - To Play Claw" description="Browse agent-native AI tools by category, type, source quality, and agent compatibility.">
  <section class="tools-page page">
    <section class="tools-hero">
      <div>
        <div class="route-chip"><span></span>Tools directory</div>
        <h1>Browse AI tools by category. Verify them like infrastructure.</h1>
        <p>
          Start with the user-facing AI category, then narrow by MCP, Skill, CLI,
          Workflow, source trust, stars, and compatible agent.
        </p>
      </div>
      <aside class="type-stats">
        {["mcp", "skill", "cli", "workflow", "agent-app", "agent-framework", "sdk"].map((type) => (
          <a href={`/type/${type}`}>
            <strong>{typeCounts[type] ?? 0}</strong>
            <span>{type}</span>
          </a>
        ))}
      </aside>
    </section>

    <section class="category-strip">
      {aiCategories.map((category) => (
        <a class={`category-card tone-${category.tone}`} href={category.href}>
          <div>
            <span>{category.count} tools</span>
            <h2>{category.title}</h2>
          </div>
          <p>{category.sub.join(" / ")}</p>
        </a>
      ))}
    </section>

    <section class="tool-shell">
      <aside class="filters">
        <strong>Refine tools</strong>
        <a class="active" href="/tools">All tools</a>
        <a href="/type/mcp">MCP servers</a>
        <a href="/type/skill">Skills</a>
        <a href="/type/cli">CLI tools</a>
        <a href="/type/workflow">Workflows</a>
        <a href="/type/agent-app">Agent Apps</a>
        <a href="/type/agent-framework">Frameworks</a>
        <a href="/type/sdk">SDKs</a>
        <a href="/agents">Agent compatibility</a>
        <a href="/signals">Source signals</a>
      </aside>

      <div class="tool-list">
        {pageTools.map((tool) => (
          <article class="tool-row">
            <div class="tool-main">
              <div class="tags">
                <span>{tool.type}</span>
                {(tool.category || []).slice(0, 3).map((category) => <span>{category}</span>)}
              </div>
              <h2><a href={`/item/${tool.id}`}>{tool.name}</a></h2>
              <p>{tool.summary}</p>
              <div class="agent-line">
                {(tool.compatibleAgents || []).slice(0, 4).map((agent) => <span>{agent}</span>)}
              </div>
            </div>
            <div class="metrics">
              <div>
                <strong>{tool.stars ? tool.stars.toLocaleString() : "linked"}</strong>
                <span>stars</span>
              </div>
              <div>
                <strong>{tool.license || "source"}</strong>
                <span>license</span>
              </div>
              <div>
                <strong>{tool.lastUpdated ? "fresh" : "source"}</strong>
                <span>status</span>
              </div>
              <a href={`/item/${tool.id}`}>Open</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {totalPages > 1 && (
      <nav class="pagination">
        {page > 1 && <a href={`?page=${page - 1}`}>← Previous</a>}
        {Array.from({ length: totalPages }, (_, i) => i + 1)
          .filter(n => n === 1 || n === totalPages || Math.abs(n - page) <= 2)
          .map((n, i, arr) => (
            <>
              {i > 0 && arr[i - 1] !== n - 1 && <span>…</span>}
              <a class:list={[{ active: n === page }]} href={`?page=${n === 1 ? '' : n}`}>
                {n}
              </a>
            </>
          ))}
        {page < totalPages && <a href={`?page=${page + 1}`}>Next →</a>}
      </nav>
    )}
  </section>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 12% 0%, rgb(134 174 255 / 0.18), transparent 30rem),
      radial-gradient(circle at 90% 8%, rgb(229 183 106 / 0.13), transparent 28rem),
      radial-gradient(circle at 58% 86%, rgb(80 220 160 / 0.1), transparent 34rem),
      #080b10;
  }

  .tools-page {
    padding: 42px 0 72px;
  }

  .tools-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 18px;
    align-items: stretch;
  }

  .tools-hero > div,
  .type-stats,
  .category-card,
  .filters,
  .tool-row {
    border: 1px solid rgb(246 242 234 / 0.11);
    background:
      linear-gradient(180deg, rgb(246 242 234 / 0.07), rgb(246 242 234 / 0.026)),
      rgb(12 17 24 / 0.82);
    box-shadow: 0 30px 100px rgb(0 0 0 / 0.32);
    backdrop-filter: blur(30px);
  }

  .tools-hero > div {
    padding: clamp(28px, 4vw, 50px);
    border-radius: 40px;
  }

  .route-chip {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    padding: 9px 12px;
    color: #d9e6ff;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    border: 1px solid rgb(134 174 255 / 0.26);
    border-radius: 999px;
    background: rgb(134 174 255 / 0.1);
  }

  .route-chip span {
    width: 8px;
    height: 8px;
    background: #e5b76a;
    border-radius: 999px;
  }

  h1 {
    max-width: 850px;
    margin-top: 24px;
    font-family: var(--sans);
    font-size: clamp(42px, 5.5vw, 72px);
    font-weight: 790;
    line-height: 0.92;
    letter-spacing: -0.08em;
  }

  .tools-hero p {
    max-width: 620px;
    margin-top: 20px;
    color: #b1b8c7;
    font-size: 15px;
    line-height: 1.68;
  }

  .type-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 18px;
    border-radius: 40px;
  }

  .type-stats a {
    min-height: 120px;
    padding: 16px;
    border: 1px solid rgb(134 174 255 / 0.14);
    border-radius: 24px;
    background: rgb(246 242 234 / 0.035);
  }

  .type-stats strong {
    display: block;
    color: #e5b76a;
    font-size: 36px;
    letter-spacing: -0.07em;
  }

  .type-stats span {
    color: #9aa4b6;
    text-transform: uppercase;
  }

  .category-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 26px;
  }

  .category-card {
    position: relative;
    min-height: 150px;
    padding: 18px;
    overflow: hidden;
    border-radius: 28px;
  }

  .category-card::after {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 72px;
    height: 72px;
    content: "";
    background: var(--tone);
    border-radius: 28px 999px 999px;
    filter: blur(1px);
  }

  .tone-blue { --tone: rgb(134 174 255 / 0.5); }
  .tone-amber { --tone: rgb(229 183 106 / 0.48); }
  .tone-green { --tone: rgb(82 220 160 / 0.42); }
  .tone-rose { --tone: rgb(248 113 113 / 0.36); }
  .tone-violet { --tone: rgb(167 139 250 / 0.38); }
  .tone-mint { --tone: rgb(45 212 191 / 0.36); }

  .category-card span {
    color: #8fb7ff;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .category-card h2 {
    max-width: 250px;
    margin-top: 18px;
    font-family: var(--sans);
    font-size: 25px;
    letter-spacing: -0.06em;
  }

  .category-card p {
    margin-top: 16px;
    color: #9aa4b6;
    font-size: 13px;
  }

  .tool-shell {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 16px;
    margin-top: 34px;
  }

  .filters {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-self: start;
    padding: 18px;
    border-radius: 28px;
  }

  .filters strong {
    margin-bottom: 6px;
  }

  .filters a {
    min-height: 40px;
    padding: 11px 12px;
    color: #aab4c4;
    border: 1px solid rgb(246 242 234 / 0.09);
    border-radius: 999px;
    background: rgb(246 242 234 / 0.035);
  }

  .filters a.active {
    color: #0a0e13;
    background: #8fb7ff;
  }

  .tool-list {
    display: grid;
    gap: 10px;
  }

  .tool-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 16px;
    padding: 16px;
    border-radius: 24px;
  }

  .tags,
  .agent-line {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tags span,
  .agent-line span {
    display: inline-flex;
    padding: 7px 9px;
    color: #c8d0dd;
    font-size: 11px;
    font-weight: 850;
    text-transform: uppercase;
    border: 1px solid rgb(246 242 234 / 0.1);
    border-radius: 999px;
    background: rgb(246 242 234 / 0.05);
  }

  .tool-row h2 {
    margin-top: 12px;
    font-family: var(--sans);
    font-size: 22px;
    letter-spacing: -0.055em;
  }

  .tool-row h2 a:hover {
    color: #8fb7ff;
  }

  .tool-row p {
    display: -webkit-box;
    margin-top: 8px;
    overflow: hidden;
    color: #9aa4b6;
    font-size: 14px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .agent-line {
    margin-top: 12px;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    align-content: center;
  }

  .metrics div {
    padding: 10px;
    border: 1px solid rgb(246 242 234 / 0.08);
    border-radius: 16px;
    background: rgb(246 242 234 / 0.035);
  }

  .metrics strong {
    display: block;
    color: #e5b76a;
    overflow: hidden;
    font-size: 15px;
    letter-spacing: -0.035em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .metrics span {
    color: #8f98aa;
    font-size: 11px;
  }

  .metrics a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    grid-column: 1 / -1;
    min-height: 40px;
    color: #0a0e13;
    font-weight: 850;
    border-radius: 999px;
    background: #e5b76a;
  }

  @media (max-width: 1100px) {
    .tools-hero,
    .tool-shell {
      grid-template-columns: 1fr;
    }

    .category-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filters {
      position: static;
    }
  }

  @media (max-width: 720px) {
    .tools-page {
      padding-top: 28px;
    }

    .tools-hero > div,
    .type-stats,
    .category-card,
    .tool-row,
    .filters {
      border-radius: 26px;
    }

    .category-strip,
    .tool-row,
    .metrics {
      grid-template-columns: 1fr;
    }
  }

  .pagination {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 24px;
  }

  .pagination a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    padding: 0 10px;
    color: #aab4c4;
    border: 1px solid rgb(246 242 234 / 0.1);
    border-radius: 12px;
    background: rgb(246 242 234 / 0.04);
  }

  .pagination a.active {
    color: #0a0e13;
    background: #e5b76a;
    border-color: #e5b76a;
  }

  .pagination a:hover:not(.active) {
    border-color: rgb(134 174 255 / 0.3);
  }

  .pagination span {
    display: inline-flex;
    align-items: center;
    padding: 0 4px;
    color: #5a6377;
  }
</style>

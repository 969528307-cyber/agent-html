---
import BaseLayout from "../../layouts/BaseLayout.astro";

const styleDirections = [
  {
    id: "studio",
    name: "Editorial Studio",
    mood: "杂志感 / 留白 / 高端目录",
    headline: "A quieter directory for serious agent builders.",
    body: "适合把 agentk.it 做成高质量工具目录和研究入口，像 curated intelligence desk，不像普通工具导航站。",
    palette: ["#f4efe6", "#181714", "#6b5d46", "#b48b58"],
    modules: ["Tools as catalog", "Signals as briefings", "Learn as essays"],
  },
  {
    id: "lab",
    name: "Technical Lab",
    mood: "终端 / 数据 / 工程感",
    headline: "Every agent tool, scored and mapped.",
    body: "适合强调 GitHub stars、更新时间、兼容矩阵、自动发布管线，偏开发者和工程可信度。",
    palette: ["#07100d", "#d8f7d3", "#64d29b", "#7aa7ff"],
    modules: ["Compatibility matrix", "Quality gates", "Source evidence"],
  },
  {
    id: "atlas",
    name: "AI Atlas",
    mood: "分类地图 / 探索 / 产品感",
    headline: "Browse AI tools by what you want to build.",
    body: "最接近 Futurepedia 的方向，但更克制。适合先按 AI 种类浏览，再筛 MCP / Skill / CLI / Workflow。",
    palette: ["#10141f", "#f6f2ea", "#8fb7ff", "#e5b76a"],
    modules: ["AI categories", "Subcategory cards", "Featured tools"],
  },
  {
    id: "mono",
    name: "Mono Index",
    mood: "极简 / 黑白 / 快速检索",
    headline: "A fast index for agent-native tools.",
    body: "适合信息量大、更新频繁、工具数量多的阶段。视觉不花，但非常清楚，像 Linear + Hacker News 的混合。",
    palette: ["#f7f7f2", "#111111", "#777777", "#d8ff78"],
    modules: ["Fast search", "Dense lists", "Minimal detail"],
  },
];
---

<BaseLayout title="UI Style Directions - agentk.it" description="Alternative front-end style directions for agentk.it." noindex>
  <section class="style-lab page">
    <div class="lab-hero">
      <span>Style exploration</span>
      <h1>Four different visual directions for agentk.it.</h1>
      <p>
        这页不是正式页面，是用来选风格的。每个方向都能承载 Tools / Agents / Learn / Signals，
        但气质不一样。
      </p>
    </div>

    <div class="style-grid">
      {styleDirections.map((style) => (
        <article class={`style-card ${style.id}`}>
          <div class="style-top">
            <div>
              <span>{style.mood}</span>
              <h2>{style.name}</h2>
            </div>
            <div class="palette">
              {style.palette.map((color) => <i style={`--swatch:${color}`}></i>)}
            </div>
          </div>
          <div class="mini-screen">
            <div class="screen-nav">
              <b></b>
              <b></b>
              <b></b>
            </div>
            <h3>{style.headline}</h3>
            <p>{style.body}</p>
            <div class="module-row">
              {style.modules.map((module) => <span>{module}</span>)}
            </div>
            <div class="fake-content">
              <div></div>
              <div></div>
              <div></div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="recommendation">
      <span>My recommendation</span>
      <h2>如果做工具聚合站，我建议选 AI Atlas，再混一点 Technical Lab。</h2>
      <p>
        AI Atlas 负责普通用户能看懂的分类入口；Technical Lab 负责我们独有的可信度、兼容矩阵、自动发布管线。
        Editorial Studio 可以用于 Signals / Learn，Mono Index 可以作为搜索结果页或内部候选池。
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 20% 4%, rgb(229 183 106 / 0.16), transparent 28rem),
      radial-gradient(circle at 86% 12%, rgb(143 183 255 / 0.12), transparent 26rem),
      #080909;
  }

  .style-lab {
    padding: 70px 0 90px;
  }

  .lab-hero {
    max-width: 850px;
  }

  .lab-hero span,
  .recommendation span,
  .style-card span {
    color: #b7cbb4;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lab-hero h1 {
    margin-top: 16px;
    font-family: var(--sans);
    font-size: clamp(48px, 7vw, 86px);
    font-weight: 760;
    line-height: 0.94;
    letter-spacing: -0.075em;
  }

  .lab-hero p,
  .recommendation p {
    max-width: 650px;
    margin-top: 22px;
    color: #9fa99f;
    font-size: 16px;
    line-height: 1.8;
  }

  .style-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 42px;
  }

  .style-card {
    padding: 18px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 34px;
    background: rgb(255 255 255 / 0.035);
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.25);
  }

  .style-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: start;
    padding: 6px 4px 16px;
  }

  .style-top h2 {
    margin-top: 8px;
    font-family: var(--sans);
    font-size: 30px;
    font-weight: 760;
    letter-spacing: -0.06em;
  }

  .palette {
    display: flex;
    gap: 6px;
  }

  .palette i {
    width: 22px;
    height: 22px;
    background: var(--swatch);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
  }

  .mini-screen {
    min-height: 430px;
    padding: 26px;
    overflow: hidden;
    border-radius: 26px;
  }

  .screen-nav {
    display: flex;
    gap: 8px;
    margin-bottom: 46px;
  }

  .screen-nav b {
    width: 38px;
    height: 8px;
    border-radius: 999px;
  }

  .mini-screen h3 {
    max-width: 520px;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 0.95;
    letter-spacing: -0.075em;
  }

  .mini-screen p {
    max-width: 500px;
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.75;
  }

  .module-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .module-row span {
    padding: 8px 10px;
    font-size: 11px;
    border-radius: 999px;
  }

  .fake-content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 34px;
  }

  .fake-content div {
    min-height: 94px;
    border-radius: 18px;
  }

  .studio .mini-screen {
    color: #17130f;
    background: #f4efe6;
  }

  .studio .screen-nav b,
  .studio .module-row span,
  .studio .fake-content div {
    background: #d9cbb7;
  }

  .studio .mini-screen p {
    color: #5e5548;
  }

  .studio .mini-screen h3 {
    font-family: var(--display);
    letter-spacing: -0.045em;
  }

  .lab .mini-screen {
    color: #d8f7d3;
    background:
      linear-gradient(transparent 31px, rgb(100 210 155 / 0.08) 32px),
      linear-gradient(90deg, transparent 31px, rgb(100 210 155 / 0.08) 32px),
      #07100d;
    background-size: 32px 32px;
  }

  .lab .screen-nav b,
  .lab .module-row span,
  .lab .fake-content div {
    background: rgb(100 210 155 / 0.18);
    border: 1px solid rgb(100 210 155 / 0.22);
  }

  .lab .mini-screen p {
    color: #93b99e;
  }

  .atlas .mini-screen {
    color: #f6f2ea;
    background:
      radial-gradient(circle at 86% 18%, rgb(143 183 255 / 0.28), transparent 18rem),
      radial-gradient(circle at 15% 80%, rgb(229 183 106 / 0.24), transparent 18rem),
      #10141f;
  }

  .atlas .screen-nav b,
  .atlas .module-row span,
  .atlas .fake-content div {
    background: rgb(246 242 234 / 0.1);
    border: 1px solid rgb(246 242 234 / 0.12);
  }

  .atlas .mini-screen p {
    color: #b9bdc8;
  }

  .mono .mini-screen {
    color: #111;
    background: #f7f7f2;
  }

  .mono .screen-nav b,
  .mono .module-row span,
  .mono .fake-content div {
    background: #111;
  }

  .mono .module-row span {
    color: #f7f7f2;
  }

  .mono .mini-screen p {
    color: #555;
  }

  .recommendation {
    margin-top: 22px;
    padding: 34px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 34px;
    background:
      radial-gradient(circle at 90% 15%, rgb(185 232 173 / 0.12), transparent 22rem),
      rgb(255 255 255 / 0.035);
  }

  .recommendation h2 {
    max-width: 820px;
    margin-top: 12px;
    font-family: var(--sans);
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -0.065em;
  }

  @media (max-width: 900px) {
    .style-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
